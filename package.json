{
    "name": "@noeldemartin/solid-utils",
    "version": "0.6.1",
    "license": "MIT",
    "author": "Noel De Martin",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoelDeMartin/solid-utils.git"
    },
    "files": [
        "src",
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/noeldemartin-solid-utils.d.ts",
            "default": "./dist/noeldemartin-solid-utils.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "default": "./dist/vitest.js"
        },
        "./chai": {
            "types": "./dist/chai.d.ts",
            "default": "./dist/chai.js"
        }
    },
    "scripts": {
        "build": "vp pack",
        "test": "vp test"
    },
    "dependencies": {
        "@noeldemartin/utils": "next",
        "@rdfjs/types": "^2.0.1",
        "jsonld": "^8.3.3",
        "md5": "^2.3.0",
        "n3": "^1.24.2"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@noeldemartin/scripts": "next",
        "@noeldemartin/testing": "next",
        "@noeldemartin/vite-plus-config": "next",
        "@tsconfig/node26": "^26.0.1",
        "@types/chai": "^5.2.0",
        "@types/jsonld": "^1.5.15",
        "@types/md5": "^2.3.5",
        "@types/n3": "^1.26.4",
        "@types/node": "^26.6.3",
        "publint": "^0.3.24",
        "typescript": "~6.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:"
